{
    "c": {
        "prefix": "mkc",
        "body": [
            "CC := cc",
            "CFLAGS := -std=gnu17 -Wall",
            "SRCS := \\$(wildcard *.c)",
            "",
            ".PHONY: all",
            "",
            "all: main",
            "",
            "main: \\$(SRCS)",
            "\t@\\$(CC) \\$(CFLAGS) \\$^ -o \\$@",
            "\t@./\\$@ && rm \\$@"
        ],
        "description": "basic Makefile"
    },
    "cp": {
        "prefix": "mkp",
        "body": [
            "CC = cc",
            "CFLAGS = -std=gnu17 -Wall -O2",
            "",
            "TARGET := main",
            "SRCS := src/\\$(TARGET).c \\$(wildcard src/*/*.c)",
            "OBJS := \\$(patsubst %.c, obj/%.o,\\$(SRCS))",
            "DEPS := \\$(OBJS:%.o=%.d)",
            "",
            "all: bin/\\$(TARGET)",
            "\t@./\\$<",
            "",
            "bin/\\$(TARGET): \\$(OBJS)",
            "\t@\\$(CC) \\$(CFLAGS) \\$^ -o  \\$@",
            "",
            "obj/%.o: %.c",
            "\t@mkdir -p \\$(@D)",
            "\t@\\$(CC) \\$(CFLAGS) -MMD -MP \\$< -c -o \\$@",
            "",
            "clean:",
            "\t@rm -rf ./bin ./obj",
            "",
            ".PHONY: all clean",
            "-include \\$(DEPS)"
        ],
        "description": "tiny c project"
    },
    "cc": {
        "prefix": "mkx",
        "body": [
            "CXX := clang++",
            "CXXFLAGS := -std=c++17 -Wall -Wextra -Wfatal-errors",
            "%:",
            "\t@\\$(CXX) \\$(CXXFLAGS) \\$@.cc -o main",
            "\t@./main",
            "\t@touch \\$@"
        ],
        "description": "Makefile by name"
    }
}
