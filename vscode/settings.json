{
    "chat.disableAIFeatures": true,
    "security.workspace.trust.enabled": false,
    "git.openRepositoryInParentFolders": "never",
    "window.commandCenter": false,
    "window.autoDetectColorScheme": true,
    "workbench.sideBar.location": "right",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.activityBar.location": "top",
    "workbench.editor.enablePreview": false,
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.preferredLightColorTheme": "Light Modern",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.minimap.enabled": false,
    "editor.fontFamily": "IosevkaTerm Nerd Font",
    "editor.fontSize": 14,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 8,
    "editor.linkedEditing": true, //修改 HTML 标签名时，同步编辑开始/结束标签
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "terminal.integrated.fontFamily": "IosevkaTerm Nerd Font Mono",
    "terminal.integrated.fontSize": 14,
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true, // 自动在文件末尾插入一个空行
    "files.trimFinalNewlines": true, // 自动删除文件末尾多余的空行（保持只有一个空行）
    // EXTENSION
    "extensions.ignoreRecommendations": true,
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },
    "todohighlight.keywords": [
        {
            "text": "NOTE:",
            "color": "#000000",
            "backgroundColor": "#10B981",
            "overviewRulerColor": "grey"
        },
        {
            "text": "TODO:",
            "color": "#FFFFFF",
            "backgroundColor": "#DC2626",
            "overviewRulerColor": "grey"
        },
        {
            "text": "DONE:",
            "color": "#FFFFFF",
            "backgroundColor": "#1957F3",
            "overviewRulerColor": "grey"
        }
    ],
    "vim.easymotion": false,
    "vim.useCtrlKeys": true,
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.vimrc.enable": true,
    "vim.vimrc.path": "~/.dotfiles/vscode/vsc.vim"
}
